# Public
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Astrology
# Use vedastro for real calculations. Use development only for local UI work.
ASTROLOGY_PROVIDER="vedastro"
VEDASTRO_API_KEY=""
VEDASTRO_API_BASE_URL="https://api.vedastro.org/api"
VEDASTRO_TIMEOUT_MS="10000"
VEDASTRO_RETRY_COUNT="1"

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ravish_astro"

# Auth (Better Auth)
# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-strong-secret"
# Public origin used to build OAuth callback URLs.
BETTER_AUTH_URL="http://localhost:3000"
# Legacy alias, still read as a fallback for BETTER_AUTH_SECRET.
AUTH_SECRET="replace-with-a-strong-secret"

# Google OAuth
# Authorised redirect URI (local):      http://localhost:3000/api/auth/callback/google
# Authorised redirect URI (production): https://your-domain/api/auth/callback/google
# The secret is server-only and must never be exposed to the browser.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Local/CI only. Enables email+password sign-in so automated flows can run
# without live Google credentials. Ignored whenever NODE_ENV=production.
ENABLE_DEV_CREDENTIALS="false"

# Payments
# Checkout is intentionally disabled by default until report fulfilment is ready.
PAYMENT_PROVIDER="razorpay"
REPORT_CHECKOUT_ENABLED="false"
# Razorpay test mode keys for local/staging checkout.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook endpoint: /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=""

# AI report interpretation
# "gemini" in production. "development" emits clearly-labelled placeholder text
# and is refused when NODE_ENV=production.
AI_PROVIDER="gemini"
AI_MODEL="gemini-2.5-flash"
AI_PROVIDER_API_KEY=""

# Shared secret for the report generation worker (POST /api/jobs/reports).
# The worker is disabled unless this is set to at least 16 characters.
JOBS_SECRET=""

# Storage
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Email
EMAIL_FROM="Ravish Astro <no-reply@ravishastro.com>"
EMAIL_PROVIDER_API_KEY=""
