# Public
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Astrology
# Charts are calculated in this application - there is no astrology API, no key
# and no quota. Leave this unset to use the built-in engine. "development"
# selects a deterministic fixture for local UI work and is refused in
# production.
# ASTROLOGY_PROVIDER="native"

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/tarun_astro"

# Auth (Better Auth)
# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-strong-secret"
# Public origin used to build OAuth callback URLs.
BETTER_AUTH_URL="http://localhost:3000"
# Legacy alias, still read as a fallback for BETTER_AUTH_SECRET.
AUTH_SECRET="replace-with-a-strong-secret"

# Google OAuth
# Authorised redirect URI (local):      http://localhost:3000/api/auth/callback/google
# Authorised redirect URI (production): https://your-domain/api/auth/callback/google
# The secret is server-only and must never be exposed to the browser.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Local/CI only. Enables email+password sign-in so automated flows can run
# without live Google credentials. Ignored whenever NODE_ENV=production.
ENABLE_DEV_CREDENTIALS="false"

# Payments
# Checkout is intentionally disabled by default until report fulfilment is ready.
PAYMENT_PROVIDER="razorpay"
REPORT_CHECKOUT_ENABLED="false"
# Razorpay test mode keys for local/staging checkout.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook endpoint: /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=""

# AI report interpretation
# "gemini" in production. "development" emits clearly-labelled placeholder text
# and is refused when NODE_ENV=production.
AI_PROVIDER="gemini"
AI_MODEL="gemini-2.5-flash"
AI_PROVIDER_API_KEY=""

# Shared secret for the report generation worker (POST /api/jobs/reports).
# The worker is disabled unless this is set to at least 16 characters.
JOBS_SECRET=""

# Object storage for generated report PDFs (S3-compatible; Cloudflare R2 works).
# Required in production. Without it, development falls back to local .storage/.
# Objects are private: downloads are always via short-lived signed URLs.
STORAGE_ENDPOINT=""
STORAGE_REGION=""
# Required in production. Generated report PDFs and practitioner verification
# documents are private customer data and must go to object storage, not a
# local filesystem: an ephemeral instance loses them, and a shared volume is
# not access-controlled. Objects are written private; every download goes
# through an authenticated route that mints a short-lived signed URL.
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Email
EMAIL_FROM="Tarun Astro <no-reply@tarunastro.com>"
EMAIL_PROVIDER_API_KEY=""

# Distributed rate limiting (Upstash Redis REST).
# Required in production: without a shared store the limiter has no shared
# counter across instances. Development falls back to an in-process store.
# Both values are server-only and must never be exposed to the browser.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Deployment topology, used to decide which header identifies a client.
# Rate limiting keys on this, so an incorrect value either lets a caller forge
# unlimited buckets or lumps every visitor together. Required in production.
#   vercel | cloudflare | fly  -> trust that platform's own client-ip header
#   generic                    -> behind your own reverse proxy; see HOPS below
#   none (default)             -> trust nothing; all anonymous callers share a bucket
TRUSTED_PROXY_PLATFORM="none"
# Only for "generic": how many proxies of yours append to X-Forwarded-For.
TRUSTED_PROXY_HOPS="1"

# Server log verbosity: debug | info | warn | error. Defaults to info in
# production and debug elsewhere.
LOG_LEVEL=""

# Root key for provider credentials saved through the admin control centre, and
# for practitioner payout details. Required in production.
# 32 bytes, base64 or hex. Generate with: openssl rand -base64 32
#
# Without it the admin cannot store credentials, providers fall back to the
# environment variables above, and a practitioner cannot save bank details at
# all - the application refuses rather than storing them in the clear. It is
# never stored in the database, never shown in the admin and never returned to
# a browser.
CONFIG_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Consultation calling provider (voice and video)
# ---------------------------------------------------------------------------
# NOT CONNECTED. The provider interface, session lifecycle, participant-token
# minting and UI states are implemented; no adapter for a real carrier exists
# yet, so voice and video sessions report themselves as unavailable rather than
# opening a call window that cannot connect. Chat consultations work without
# this - they are carried by this application's own consultation-scoped
# messages.
#
# Both halves must be set together or neither; production startup refuses a
# half-configured pair. The app secret is server-only: a participant joins with
# a short-lived token minted on the server, never with this value.
CALL_PROVIDER_APP_ID=""
CALL_PROVIDER_APP_SECRET=""

# ---------------------------------------------------------------------------
# Practitioner payout provider (RazorpayX, Cashfree Payouts or similar)
# ---------------------------------------------------------------------------
# NOT CONNECTED. The earnings ledger, payout batching, state machine, audit
# trail and provider interface are implemented. No adapter exists, so payouts
# record an operator's own bank transfer and its reference.
#
# When an adapter is added, note the rule it must follow: requesting a transfer
# moves a payout to PROCESSING, never to PAID. Only a provider confirmation -
# webhook or status poll - marks one paid.
#
# Both key halves must be set together or neither.
PAYOUT_PROVIDER_KEY_ID=""
PAYOUT_PROVIDER_KEY_SECRET=""
PAYOUT_PROVIDER_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Messaging providers
# ---------------------------------------------------------------------------
# NOT CONNECTED. Credential slots exist and are surfaced on the integrations
# page as "not implemented" rather than "not configured", because a key stored
# here today is held safely but nothing consumes it.
SMS_PROVIDER_API_KEY=""
WHATSAPP_PROVIDER_API_KEY=""
PUSH_PROVIDER_API_KEY=""

# ---------------------------------------------------------------------------
# Optional third-party services
# ---------------------------------------------------------------------------
# Maps/geocoding only extends place lookup; the bundled location provider
# already covers birth-place search. Analytics here is a third-party product
# analytics key - the platform metrics on /admin/analytics are computed in-app
# from real rows and need no key.
MAPS_PROVIDER_API_KEY=""
ANALYTICS_PROVIDER_API_KEY=""
