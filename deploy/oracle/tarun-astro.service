[Unit]
Description=Tarun Astro Next.js Production Service
After=network.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=Tarun
Group=Tarun
WorkingDirectory=/opt/tarun-astro/current
EnvironmentFile=/etc/tarun-astro/tarun-astro.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=NODE_OPTIONS="--max-old-space-size=2048"

ExecStart=/usr/bin/pnpm start
ExecReload=/bin/kill -HUP $MAINPID

# Crash-Proof Self-Healing Directives
Restart=always
RestartSec=3s
StartLimitIntervalSec=60s
StartLimitBurst=10

# Graceful termination
TimeoutStopSec=30
KillSignal=SIGINT

# Resource limits & hardening
MemoryMax=2.5G
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
