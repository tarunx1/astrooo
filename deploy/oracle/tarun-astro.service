[Unit]
Description=Tarun Astro Next.js application
After=network.target postgresql.service

[Service]
Type=simple
User=Tarun
Group=Tarun
WorkingDirectory=/opt/tarun-astro/current
EnvironmentFile=/etc/tarun-astro/tarun-astro.env
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/pnpm start
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT

# Basic hardening. Keep write access available for Next cache/runtime files in
# the release directory; secrets stay in the root-owned EnvironmentFile.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
