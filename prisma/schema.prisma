generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Platform roles.
///
/// CUSTOMER, EMPLOYEE, PANDIT, ADMIN and SUPER_ADMIN are live. ASTROLOGER and
/// EDITOR are retained from the original scaffold so no existing row becomes
/// unreadable; nothing grants them and no code path assigns them.
///
/// A role is only ever a *default bundle* of permissions. Authorization is
/// decided by permission, never by comparing a role name - see
/// `lib/auth/permissions.ts`.
enum UserRole {
  CUSTOMER
  ASTROLOGER
  EDITOR
  ADMIN
  SUPER_ADMIN
  EMPLOYEE
  PANDIT
}

enum ProductType {
  PHYSICAL
  GEMSTONE
  DIGITAL_REPORT
  CONSULTATION
  PUJA
  COURSE
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  FULFILLED
  CANCELLED
  REFUNDED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum ReportStatus {
  PENDING_PAYMENT
  PAID
  QUEUED
  CALCULATING
  INTERPRETING
  RENDERING
  READY
  FAILED
  CANCELLED
  REFUNDED
}

/// Consultation lifecycle.
///
/// REQUESTED predates paid booking and is retained so no existing row becomes
/// unreadable; the customer flow starts at PENDING_PAYMENT and only reaches
/// CONFIRMED once a payment has been verified server-side.
enum ConsultationStatus {
  REQUESTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  PENDING_PAYMENT
  REFUNDED
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  PREORDER
}

enum BirthTimeAccuracy {
  EXACT
  APPROXIMATE
  UNKNOWN
}

model User {
  id                String             @id @default(cuid())
  name              String             @default("")
  email             String             @unique
  emailVerified     Boolean            @default(false)
  image             String?
  phone             String?            @unique
  role              UserRole           @default(CUSTOMER)
  accounts          Account[]
  sessions          Session[]
  addresses         Address[]
  birthProfiles     BirthProfile[]
  carts             Cart[]
  orders            Order[]
  payments          Payment[]
  reportOrders      ReportOrder[]
  consultations     Consultation[]
  pujaBookings      PujaBooking[]
  enrollments       Enrollment[]
  reviews           Review[]
  wishlistItems     Wishlist[]
  savedKundlis      SavedKundli[]
  auditLogs         AuditLog[]
  inventoryAdjustments InventoryAdjustment[]

  permissions        UserPermission[] @relation("UserPermissionHolder")
  permissionsGranted UserPermission[] @relation("UserPermissionGrantor")
  employeeProfile    EmployeeProfile? @relation("EmployeeProfileUser")
  employeesCreated   EmployeeProfile[] @relation("EmployeeProfileCreator")
  panditProfile      PanditProfile?   @relation("PanditProfileUser")
  panditsVerified    PanditProfile[]  @relation("PanditVerifier")
  panditsApproved    PanditProfile[]  @relation("PanditApprover")
  panditsRejected    PanditProfile[]  @relation("PanditRejecter")
  panditsSuspended   PanditProfile[]  @relation("PanditSuspender")
  panditDocumentsReviewed PanditDocument[] @relation("PanditDocumentReviewer")
  panditReviews      PanditReview[]   @relation("PanditReviewer")
  chatMessages       ChatMessage[]
  kundliAccessGrants PanditKundliAccess[] @relation("KundliAccessGrantor")
  payoutsProcessed   Payout[]         @relation("PayoutProcessor")
  ticketsReported    Ticket[]         @relation("TicketReporter")
  ticketsAssigned    Ticket[]         @relation("TicketAssignee")
  ticketMessages     TicketMessage[]  @relation("TicketAuthor")
  pujaAssignments    PujaBooking[]    @relation("PujaAssigner")

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([role])
}

model Account {
  id                    String    @id @default(cuid())
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String?
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("IN")
  phone      String?
  isDefault  Boolean  @default(false)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model BirthProfile {
  id            String                 @id @default(uuid())
  userId        String?
  name          String
  placeId       String?
  gender        String?
  dateOfBirth   DateTime
  timeOfBirth   String
  timeAccuracy  BirthTimeAccuracy      @default(EXACT)
  placeName     String
  placeOfBirth  String
  city          String
  region        String?
  country       String
  latitude      Decimal                @db.Decimal(9, 6)
  longitude     Decimal                @db.Decimal(9, 6)
  timezone      String
  user          User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  calculations  AstrologyCalculation[]
  savedKundlis  SavedKundli[]
  reportOrders  ReportOrder[]
  consultations Consultation[]
  panditAccess  PanditKundliAccess[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([userId])
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  articles  Article[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([parentId])
}

model Product {
  id               String           @id @default(cuid())
  type             ProductType
  title            String
  slug             String           @unique
  description      String
  categoryId       String?
  pricePaise       Int
  salePricePaise   Int?
  currency         String           @default("INR")
  sku              String?          @unique
  attributes       Json?
  active           Boolean          @default(false)
  category         Category?        @relation(fields: [categoryId], references: [id])
  variants         ProductVariant[]
  images           ProductImage[]
  inventory        Inventory?
  cartItems        CartItem[]
  orderItems       OrderItem[]
  reportDefinition ReportDefinition?
  reviews          Review[]
  wishlistItems    Wishlist[]
  couponProducts   CouponProduct[]
  inventoryAdjustments InventoryAdjustment[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([type])
  @@index([categoryId])
  @@index([active])
}

model ProductVariant {
  id             String       @id @default(cuid())
  productId      String
  title          String
  sku            String       @unique
  pricePaise     Int?
  salePricePaise Int?
  attributes     Json?
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory      Inventory?
  cartItems      CartItem[]
  orderItems     OrderItem[]
  inventoryAdjustments InventoryAdjustment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([productId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

model Inventory {
  id                String           @id @default(cuid())
  productId         String?          @unique
  productVariantId  String?          @unique
  quantity          Int              @default(0)
  status            InventoryStatus  @default(OUT_OF_STOCK)
  product           Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant    ProductVariant?  @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  updatedAt         DateTime         @updatedAt
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  /// SHA-256 of the opaque anonymous cart cookie. The raw token is never stored.
  sessionId String?
  status    CartStatus @default(ACTIVE)
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
  @@index([sessionId])
  @@index([status])
}

model CartItem {
  id               String          @id @default(cuid())
  cartId           String
  productId        String
  productVariantId String?
  quantity         Int             @default(1)
  cart             Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id])
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([cartId, productId, productVariantId])
  @@index([productId])
}

model Order {
  id              String       @id @default(cuid())
  /// Human-facing reference shown to the customer and support.
  orderNumber     String       @unique
  userId          String
  cartId          String?
  status          OrderStatus  @default(PENDING_PAYMENT)
  subtotalPaise   Int
  discountPaise   Int          @default(0)
  taxPaise        Int          @default(0)
  shippingPaise   Int          @default(0)
  totalPaise      Int
  currency        String       @default("INR")
  shippingAddress Json?
  billingAddress  Json?
  user            User         @relation(fields: [userId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  refunds         Refund[]
  reportOrders    ReportOrder[]
  pujaBookings    PujaBooking[]
  enrollments     Enrollment[]
  consultations   Consultation[]
  couponId        String?
  /// Snapshot so a renamed or deleted coupon never rewrites order history.
  couponCodeSnapshot String?
  coupon          Coupon?      @relation(fields: [couponId], references: [id], onDelete: SetNull)

  /// Razorpay order id. Unique so one provider order maps to one internal order.
  providerOrderId String?      @unique
  paidAt          DateTime?

  /// Fulfilment metadata, entered manually by an operator. No carrier
  /// integration exists, so none of this is verified against a carrier.
  carrierName    String?
  trackingNumber String?
  trackingUrl    String?
  processingAt   DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?

  /// Set exactly once when stock is decremented, making commitment idempotent
  /// against duplicate payment events.
  inventoryCommittedAt DateTime?
  /// Records any line that could not be fulfilled from stock after payment.
  inventoryShortfall   Json?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId])
  @@index([status])
  @@index([providerOrderId])
}

/// A purchased line. Every displayed value is a snapshot taken at purchase time,
/// so later edits to a product's title, SKU or price never rewrite history.
model OrderItem {
  id               String          @id @default(cuid())
  orderId          String
  productId        String
  productVariantId String?
  title            String
  skuSnapshot      String?
  variantSnapshot  Json?
  quantity         Int             @default(1)
  unitPricePaise   Int
  totalPaise       Int
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String?
  orderId           String?
  reportOrderId     String?
  consultationId    String?
  pujaBookingId     String?
  provider          String
  providerOrderId   String?
  providerPaymentId String?       @unique
  providerRef       String?       @unique
  status            PaymentStatus @default(PENDING)
  amountPaise       Int
  currency          String        @default("INR")
  rawResponse       Json?
  capturedAt        DateTime?
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  order             Order?        @relation(fields: [orderId], references: [id])
  reportOrder       ReportOrder?  @relation(fields: [reportOrderId], references: [id])
  consultation      Consultation? @relation(fields: [consultationId], references: [id])
  pujaBooking       PujaBooking?  @relation(fields: [pujaBookingId], references: [id])
  refunds           Refund[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@index([orderId])
  @@index([reportOrderId])
  @@index([consultationId])
  @@index([pujaBookingId])
  @@index([providerOrderId])
  @@index([status])
}

model Refund {
  id          String        @id @default(cuid())
  orderId     String
  paymentId   String
  amountPaise Int
  reason      String?
  status      PaymentStatus @default(PENDING)
  order       Order         @relation(fields: [orderId], references: [id])
  payment     Payment       @relation(fields: [paymentId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orderId])
  @@index([paymentId])
}

model ReportDefinition {
  id               String        @id @default(cuid())
  productId        String?       @unique
  slug             String        @unique
  name             String
  shortDescription String
  description      String
  priceMinor       Int
  currency         String        @default("INR")
  estimatedPages   Int
  sectionsIncluded Json
  requiredInputs   Json
  isActive         Boolean       @default(true)
  sortOrder        Int           @default(0)
  reportType       String
  requiredFields   Json
  sections         Json
  samplePages      Json?
  product          Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  reportOrders     ReportOrder[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([isActive, sortOrder])
  @@index([slug])
}

model ReportOrder {
  id                     String               @id @default(cuid())
  userId                 String
  orderId                String?
  reportDefinitionId     String
  birthProfileId         String?
  astrologyCalculationId String?
  status                 ReportStatus         @default(PENDING_PAYMENT)
  priceMinor             Int
  currency               String               @default("INR")
  reportNameSnapshot     String
  reportSlugSnapshot     String
  priceSnapshot          Int
  currencySnapshot       String
  providerOrderId        String?              @unique
  inputSnapshot          Json
  paidAt                 DateTime?
  user                   User                 @relation(fields: [userId], references: [id])
  order                  Order?               @relation(fields: [orderId], references: [id])
  reportDefinition       ReportDefinition     @relation(fields: [reportDefinitionId], references: [id])
  birthProfile           BirthProfile?        @relation(fields: [birthProfileId], references: [id], onDelete: SetNull)
  astrologyCalculation   AstrologyCalculation? @relation(fields: [astrologyCalculationId], references: [id], onDelete: Restrict)
  payments               Payment[]
  generatedReport        GeneratedReport?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([userId])
  @@index([status])
  @@index([reportDefinitionId])
  @@index([birthProfileId])
  @@index([astrologyCalculationId])
}

model GeneratedReport {
  id            String      @id @default(cuid())
  reportOrderId String      @unique
  status        ReportStatus @default(QUEUED)

  /// Validated ReportDocument. Never a raw unvalidated prose blob.
  document      Json?
  interpretation Json?
  chartJson     Json?

  /// Reproducibility / audit: what produced this document.
  schemaVersion          String?
  promptVersion          String?
  aiProvider             String?
  aiModel                String?
  astrologyCalculationId String?
  generatedAt            DateTime?

  /// Bounded retry bookkeeping.
  attemptCount      Int       @default(0)
  lastErrorCategory String?
  lastError         String?
  lastErrorAt       DateTime?

  /// Rendered artefact (Phase 3). Null until RENDERING completes.
  storageKey String?
  checksum   String?
  fileSize   Int?
  mimeType   String?
  pageCount  Int?
  readyAt    DateTime?

  reportOrder ReportOrder @relation(fields: [reportOrderId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@index([astrologyCalculationId])
}

/// A reserved point in a Pandit's calendar.
///
/// A row exists only while a slot is actually held. That makes the composite
/// unique below the double-booking guarantee itself rather than a hint: two
/// concurrent bookings for the same start resolve to one winner in the
/// database, not in application code that raced. Cancelling deletes the row and
/// frees the slot, while the Consultation keeps its own scheduled times as an
/// immutable record of what was booked.
model ConsultationSlot {
  id              String        @id @default(cuid())
  panditProfileId String
  startsAt        DateTime
  endsAt          DateTime
  pandit          PanditProfile @relation(fields: [panditProfileId], references: [id], onDelete: Cascade)
  consultation    Consultation?

  @@unique([panditProfileId, startsAt])
  @@index([panditProfileId, startsAt])
}

/// One booked consultation between a customer and a Pandit.
///
/// Rate and duration are snapshots taken at booking, exactly like OrderItem:
/// a Pandit raising their rate afterwards must never rewrite what a customer
/// agreed to pay or what the Pandit earned.
model Consultation {
  id              String             @id @default(cuid())
  userId          String
  panditProfileId String
  slotId          String?            @unique
  birthProfileId  String?
  orderId         String?
  status          ConsultationStatus @default(REQUESTED)
  mode            ConsultationMode
  timezone        String             @default("Asia/Kolkata")
  scheduledStart  DateTime
  scheduledEnd    DateTime
  durationMinutes Int

  /// Purchase snapshots. Never recomputed from the Pandit's current rates.
  rateType         RateType
  ratePaise        Int
  grossAmountPaise Int
  currency         String            @default("INR")

  /// The commission split, frozen when the customer paid.
  ///
  /// Settlement reads these rather than the live platform setting, so changing
  /// the commission next month reprices future bookings and rewrites nothing a
  /// customer has already been charged for or a Pandit has already earned.
  commissionPercent       Int?
  platformCommissionPaise Int?
  panditEarningPaise      Int?

  /// Razorpay order id. Unique so one provider order maps to one consultation.
  providerOrderId String?   @unique
  paidAt          DateTime?
  payments        Payment[]

  notes               String?
  startedAt           DateTime?
  endedAt             DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancelledById       String?
  cancellationReason  String?

  user          User                 @relation(fields: [userId], references: [id])
  pandit        PanditProfile        @relation(fields: [panditProfileId], references: [id])
  slot          ConsultationSlot?    @relation(fields: [slotId], references: [id], onDelete: SetNull)
  birthProfile  BirthProfile?        @relation(fields: [birthProfileId], references: [id], onDelete: SetNull)
  order         Order?               @relation(fields: [orderId], references: [id])
  messages      ChatMessage[]
  kundliAccess  PanditKundliAccess[]
  earning       EarningTransaction?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([userId])
  @@index([panditProfileId])
  @@index([status])
  @@index([scheduledStart])
}

/// How a Puja is performed on the customer's behalf.
enum PujaMode {
  /// Performed at a temple or the practitioner's own space, streamed or recorded.
  ONLINE
  /// Performed at the customer's home or a venue they arrange.
  IN_PERSON
  /// Performed at a named temple without the customer attending.
  TEMPLE
}

/// Where a Puja booking stands.
///
/// Replaces the free-form string the original model carried. Every comparison
/// in the application is against this enum, so a typo is a compile error rather
/// than a booking that silently never matches a filter.
enum PujaBookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  PANDIT_PENDING
  ASSIGNED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}

model Puja {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  description      String
  /// One line for cards and search results.
  shortDescription String        @default("")
  /// What this ritual is traditionally performed for. Descriptive, never a promise.
  purpose          String?
  /// Traditionally associated benefits. Presented as tradition, not as outcome.
  benefits         String[]
  /// What the customer must provide or prepare.
  requirements     String[]
  /// Ritual materials, as structured entries rather than prose in a component.
  samagri          Json?
  /// The steps of the ritual, as structured entries.
  vidhi            Json?
  durationMinutes  Int?
  pricePaise       Int
  currency         String        @default("INR")
  imageUrls        String[]
  modes            PujaMode[]
  sortOrder        Int           @default(0)
  active           Boolean       @default(false)
  bookings         PujaBooking[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([active, sortOrder])
}

/// One customer's booking of a Puja.
///
/// `sankalpJson` holds the family and intention details a ritual needs - gotra,
/// names, birth details. That is private customer data of the same kind as a
/// birth profile: it is never selected by a public query, never rendered
/// outside the customer's own account and the assigned practitioner's view, and
/// never written to an audit entry.
model PujaBooking {
  id      String            @id @default(cuid())
  /// Human-facing reference shown to the customer and support.
  bookingNumber String      @unique
  userId  String
  orderId String?
  pujaId  String
  status  PujaBookingStatus @default(PENDING_PAYMENT)
  mode    PujaMode          @default(ONLINE)

  /// When the ritual is to be performed. Null until an operator schedules it.
  scheduledAt DateTime?
  timezone    String        @default("Asia/Kolkata")
  /// The date the customer asked for, kept even after scheduling moves it.
  requestedDate DateTime?

  /// Purchase snapshots, frozen at booking. A later catalogue edit never
  /// rewrites what a customer was charged or what they believed they bought.
  titleSnapshot String
  pricePaise    Int
  currency      String       @default("INR")

  /// Private. See the model comment.
  sankalpJson Json?

  /// The practitioner who will perform it. Assigned by an operator.
  panditProfileId String?
  assignedAt      DateTime?
  assignedById    String?

  providerOrderId String?   @unique
  paidAt          DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancellationReason String?
  /// Operator-visible notes about fulfilment. Never shown to the customer.
  operatorNote    String?

  user       User           @relation(fields: [userId], references: [id])
  order      Order?         @relation(fields: [orderId], references: [id])
  puja       Puja           @relation(fields: [pujaId], references: [id])
  pandit     PanditProfile? @relation(fields: [panditProfileId], references: [id], onDelete: SetNull)
  assignedBy User?          @relation("PujaAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  payments   Payment[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([userId])
  @@index([pujaId])
  @@index([status])
  @@index([panditProfileId])
}

model Course {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String
  pricePaise  Int
  active      Boolean      @default(false)
  enrollments Enrollment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  orderId   String?
  user      User     @relation(fields: [userId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])
  order     Order?   @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([orderId])
}

model ArticleCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  articles    Article[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// An editorial article.
///
/// `status` and `publishedAt` are both required to be public: a row can be
/// PUBLISHED with a future `publishedAt` and stay unlisted until that moment,
/// which is what makes scheduling possible without a second mechanism. Every
/// public query asserts both, so a draft is invisible by construction.
model Article {
  id                String           @id @default(cuid())
  title             String
  slug              String           @unique
  excerpt           String?
  content           String
  status            ArticleStatus    @default(DRAFT)
  publishedAt       DateTime?
  coverImageUrl     String?
  /// Free-form editorial tags, used for related reading rather than navigation.
  tags              String[]
  /// Display name of the writer. A plain string, because an author is not
  /// necessarily an account on this platform.
  authorName        String?
  /// Overrides for the page title and meta description when the editorial
  /// headline is not the right thing for search results.
  seoTitle          String?
  seoDescription    String?
  categoryId        String?
  articleCategoryId String?
  category          Category?        @relation(fields: [categoryId], references: [id])
  articleCategory   ArticleCategory? @relation(fields: [articleCategoryId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status, publishedAt])
  @@index([publishedAt])
  @@index([categoryId])
  @@index([articleCategoryId])
}

model Review {
  id              String         @id @default(cuid())
  userId          String
  productId       String?
  panditProfileId String?
  rating          Int
  title           String?
  body            String?
  published       Boolean        @default(false)
  user            User           @relation(fields: [userId], references: [id])
  product         Product?       @relation(fields: [productId], references: [id])
  pandit          PanditProfile? @relation(fields: [panditProfileId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([productId])
  @@index([panditProfileId])
  @@index([published])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

model Coupon {
  id               String          @id @default(cuid())
  code             String          @unique
  description      String?
  percentOff       Int?
  amountOffPaise   Int?
  minOrderPaise    Int?
  maxDiscountPaise Int?
  usageLimit       Int?
  perUserLimit     Int?
  timesRedeemed    Int             @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  active           Boolean         @default(false)
  orders           Order[]
  products         CouponProduct[]
  redemptions      CouponRedemption[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([active])
}

/// One row per user per redeemed order, so perUserLimit is enforced against
/// facts rather than a counter that can drift.
model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([couponId, orderId])
  @@index([couponId, userId])
}

model CouponProduct {
  couponId  String
  productId String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
}

model AstrologyCalculation {
  id             String        @id @default(uuid())
  birthProfileId String?
  calculationType String
  provider       String
  providerVersion String
  calculationVersion String
  ayanamsa       String?
  houseSystem    String?
  calculatedAt   DateTime?
  inputHash      String
  input          Json
  result         Json?
  status         String        @default("PENDING")
  birthProfile   BirthProfile? @relation(fields: [birthProfileId], references: [id], onDelete: SetNull)
  savedKundlis   SavedKundli[]
  reportOrders   ReportOrder[]
  panditAccess   PanditKundliAccess[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([birthProfileId])
  @@index([calculationType])
  @@index([inputHash])
  @@index([status])
  @@unique([calculationType, inputHash, provider, calculationVersion])
}

model PaymentWebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String    @unique
  eventType       String
  payload         Json?
  createdAt       DateTime  @default(now())
  processedAt     DateTime?

  @@index([provider])
  @@index([eventType])
  @@index([processedAt])
}

/// A user's explicit save of a Kundli result.
///
/// AstrologyCalculation rows are globally deduplicated by inputHash, so a single
/// calculation can be reached by several people who entered identical birth
/// details. Ownership therefore lives here rather than on the calculation: each
/// saving user gets their own BirthProfile copy and their own SavedKundli row,
/// and no user's save can ever mutate or re-point another user's profile.
model SavedKundli {
  id             String               @id @default(cuid())
  userId         String
  birthProfileId String
  calculationId  String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthProfile   BirthProfile         @relation(fields: [birthProfileId], references: [id], onDelete: Cascade)
  calculation    AstrologyCalculation @relation(fields: [calculationId], references: [id], onDelete: Restrict)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([userId, calculationId])
  @@index([userId])
  @@index([birthProfileId])
  @@index([calculationId])
}

enum InventoryAdjustmentReason {
  RESTOCK
  CORRECTION
  DAMAGED
  RETURN
  MANUAL
}

/// Every deliberate stock change, with who made it and why.
///
/// Stock is never mutated without a row here: the adjustment and the write to
/// Inventory happen in one transaction, so the running total is always
/// explainable from history.
model InventoryAdjustment {
  id               String                    @id @default(cuid())
  productId        String?
  productVariantId String?
  adminUserId      String
  delta            Int
  previousQuantity Int
  newQuantity      Int
  reason           InventoryAdjustmentReason @default(MANUAL)
  note             String?
  createdAt        DateTime                  @default(now())

  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  adminUser      User            @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([productVariantId])
  @@index([createdAt])
}

enum AuditAction {
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_PRICE_CHANGED
  PRODUCT_ACTIVATED
  PRODUCT_DEACTIVATED
  PRODUCT_VARIANT_CREATED
  PRODUCT_VARIANT_UPDATED
  INVENTORY_ADJUSTED
  ORDER_STATUS_CHANGED
  ORDER_SHIPMENT_UPDATED
  REPORT_DEFINITION_UPDATED
  REPORT_DEFINITION_ACTIVATED
  REPORT_DEFINITION_DEACTIVATED
  REPORT_GENERATION_RETRIED
  COUPON_CREATED
  COUPON_UPDATED
  COUPON_ACTIVATED
  COUPON_DEACTIVATED
  USER_ROLE_CHANGED
  SYSTEM_SETTING_UPDATED
  SYSTEM_SECRET_REPLACED
  SYSTEM_SECRET_REMOVED
  PROVIDER_ENABLED
  PROVIDER_DISABLED
  PROVIDER_TESTED
  PAYMENT_MODE_CHANGED
  HOMEPAGE_CONTENT_UPDATED
  HOMEPAGE_SECTION_TOGGLED
  NAVIGATION_UPDATED
  FEATURE_SETTING_UPDATED
  SUPER_ADMIN_PROMOTED
  SUPER_ADMIN_DEMOTED
  USER_PERMISSION_GRANTED
  USER_PERMISSION_REVOKED
  USER_PERMISSION_RESET
  EMPLOYEE_CREATED
  EMPLOYEE_UPDATED
  EMPLOYEE_DEACTIVATED
  EMPLOYEE_REACTIVATED
  PANDIT_APPLICATION_SUBMITTED
  PANDIT_REVIEW_STARTED
  PANDIT_CHANGES_REQUESTED
  PANDIT_VERIFIED
  PANDIT_APPROVED
  PANDIT_ACTIVATED
  PANDIT_REJECTED
  PANDIT_SUSPENDED
  PANDIT_REINSTATED
  PANDIT_DOCUMENT_REVIEWED
  PANDIT_DOCUMENT_ACCESSED
  PANDIT_COMMISSION_CHANGED
  PANDIT_KUNDLI_ACCESS_GRANTED
  PANDIT_KUNDLI_ACCESS_REVOKED
  PANDIT_KUNDLI_ACCESSED
  PAYOUT_CREATED
  PAYOUT_PROCESSING
  PAYOUT_PAID
  PAYOUT_FAILED
  PAYOUT_HELD
  PAYOUT_RELEASED
  PAYOUT_CONFIG_CHANGED
  EARNING_ADJUSTED
  TICKET_ASSIGNED
  TICKET_STATUS_CHANGED
  PUJA_PANDIT_ASSIGNED
  PUJA_BOOKING_STATUS_CHANGED
  PUJA_CREATED
  PUJA_UPDATED
  ARTICLE_CREATED
  ARTICLE_UPDATED
  ARTICLE_PUBLISHED
  ARTICLE_UNPUBLISHED
}

/// Append-only record of sensitive operator actions.
///
/// There is deliberately no update or delete path in the admin UI. `metadata`
/// carries only safe descriptive values: never a secret, token, prompt or raw
/// provider payload.
model AuditLog {
  id          String      @id @default(cuid())
  actorUserId String
  action      AuditAction
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime    @default(now())

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

/// Runtime configuration an operator may change without a deploy.
///
/// Deliberately not a free-form KEY=value store. Every key is declared in the
/// typed registry in `lib/settings/registry.ts` with its own schema, and a key
/// that is not in the registry is refused on write and ignored on read, so this
/// table cannot become a way to inject arbitrary configuration.
///
/// Non-secret values only. Credentials live in SystemSecret, encrypted.
model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  category    String
  /// Shape is defined by the registry entry for `key`.
  valueJson   Json
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

/// Provider credentials, encrypted at rest.
///
/// A separate table from SystemSetting so the encryption boundary is a table
/// boundary: anything here is ciphertext, anything there is not. That makes
/// "did a secret ever get written in the clear" answerable by looking at one
/// place rather than auditing every row of a mixed table.
///
/// `envelope` holds the self-describing AES-256-GCM envelope produced by
/// `lib/settings/crypto.ts`. Plaintext is never stored, never returned to a
/// browser, and never written to a log or audit entry.
model SystemSecret {
  id          String   @id @default(cuid())
  key         String   @unique
  envelope    String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Editable content and presentation for one homepage section.
///
/// `key` matches a section the code already renders. A row here can change that
/// section's copy, hide it or reorder it; it can never introduce a new section,
/// markup, styling or behaviour, so the approved design stays code-controlled.
model HomepageSection {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(true)
  sortOrder   Int
  /// Structured copy fields only. Shape is defined by the section's registry entry.
  contentJson Json?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

/* =================================================================== */
/* Role-based access control                                           */
/* =================================================================== */

/// A per-user departure from their role's default permission bundle.
///
/// The set of permissions itself is declared in code (`lib/auth/permissions.ts`),
/// not in a table. That is deliberate: a permission is a name the application
/// must already understand to honour, so a row naming one the code has never
/// heard of could only ever be dead weight or a way to smuggle a string into an
/// authorization decision. What *is* per-installation - who has what - lives
/// here.
///
/// `granted = false` is a revocation, and it outranks the role default, so an
/// employee can be given the standard bundle minus one capability without
/// inventing a bespoke role.
model UserPermission {
  id          String   @id @default(cuid())
  userId      String
  /// A key from the PERMISSIONS registry. Validated on write; unknown keys are refused.
  permission  String
  granted     Boolean  @default(true)
  grantedById String?
  note        String?
  user        User     @relation("UserPermissionHolder", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy   User?    @relation("UserPermissionGrantor", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, permission])
  @@index([userId])
}

/// Operational staff.
///
/// Separate from User so deactivating a staff member is one flag on their
/// employment rather than a role change that would also strip the customer
/// account they may legitimately still have.
model EmployeeProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  jobTitle      String?
  department    String?
  active        Boolean   @default(true)
  deactivatedAt DateTime?
  createdById   String?
  user          User      @relation("EmployeeProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy     User?     @relation("EmployeeProfileCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([active])
}

/* =================================================================== */
/* Pandit onboarding, profile and services                             */
/* =================================================================== */

/// Where a Pandit is in onboarding.
///
/// One column, not a scatter of booleans. `isVerified && isApproved && !isActive`
/// has eight combinations of which only a handful are meaningful, and nothing
/// stops code from writing one of the others; a single status has exactly the
/// states the business actually has, and every transition is checked against a
/// declared table in `lib/pandit/onboarding.ts`.
enum PanditOnboardingStatus {
  REQUESTED
  PROFILE_STARTED
  DOCUMENTS_PENDING
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  VERIFIED
  APPROVED
  PROFILE_COMPLETION_REQUIRED
  ACTIVE
  REJECTED
  SUSPENDED
}

enum ConsultationMode {
  CHAT
  VOICE_CALL
  VIDEO_CALL
}

enum RateType {
  PER_MINUTE
  FIXED_SESSION
}

model PanditProfile {
  id     String                 @id @default(cuid())
  userId String                 @unique
  status PanditOnboardingStatus @default(REQUESTED)

  /// Public identity. `slug` is only minted at activation, so an unapproved
  /// applicant has no addressable public page even by guessing.
  displayName     String  @default("")
  slug            String? @unique
  headline        String?
  bio             String?
  profileImageUrl String?

  phone     String?
  city      String?
  state     String?
  country   String  @default("IN")
  timezone  String  @default("Asia/Kolkata")

  yearsOfExperience Int?
  languages         String[]
  expertise         String[]
  certifications    String[]

  /// Overrides the platform default when set. Snapshotted onto every earning.
  commissionPercent Int?

  submittedAt        DateTime?
  reviewStartedAt    DateTime?
  changesRequestedAt DateTime?
  changeRequestNote  String?
  verifiedAt         DateTime?
  verifiedById       String?
  approvedAt         DateTime?
  approvedById       String?
  activatedAt        DateTime?
  rejectedAt         DateTime?
  rejectedById       String?
  rejectionReason    String?
  suspendedAt        DateTime?
  suspendedById      String?
  suspensionReason   String?

  user       User   @relation("PanditProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User?  @relation("PanditVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  approvedBy User?  @relation("PanditApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy User?  @relation("PanditRejecter", fields: [rejectedById], references: [id], onDelete: SetNull)
  suspendedBy User? @relation("PanditSuspender", fields: [suspendedById], references: [id], onDelete: SetNull)

  documents    PanditDocument[]
  reviewTrail  PanditReview[]
  services     PanditService[]
  scheduleRules      PanditScheduleRule[]
  scheduleExceptions PanditScheduleException[]
  slots         ConsultationSlot[]
  consultations Consultation[]
  kundliAccess  PanditKundliAccess[]
  earnings      EarningTransaction[]
  payouts       Payout[]
  payoutAccount PayoutAccount?
  reviews       Review[]
  pujaBookings  PujaBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum PanditDocumentType {
  IDENTITY
  ADDRESS
  CERTIFICATE
  EXPERIENCE
  OTHER
}

enum PanditDocumentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// A submitted verification document.
///
/// Only a private storage key is held - never a public URL and never the bytes.
/// Access is minted per request as a short-lived signed URL for the owning
/// Pandit or an authorized reviewer, so a leaked key from a screenshot or a log
/// is not itself a way to read someone's identity document.
model PanditDocument {
  id              String               @id @default(cuid())
  panditProfileId String
  type            PanditDocumentType
  status          PanditDocumentStatus @default(PENDING)
  storageKey      String
  fileName        String
  mimeType        String
  fileSize        Int
  checksum        String?
  note            String?
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?

  pandit     PanditProfile @relation(fields: [panditProfileId], references: [id], onDelete: Cascade)
  reviewedBy User?         @relation("PanditDocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([panditProfileId])
  @@index([status])
}

enum PanditReviewDecision {
  SUBMITTED
  REVIEW_STARTED
  CHANGES_REQUESTED
  VERIFIED
  APPROVED
  ACTIVATED
  REJECTED
  SUSPENDED
  REINSTATED
}

/// Every onboarding decision, with who made it and when.
///
/// Append-only, like AuditLog, but kept as its own table because it is part of
/// the applicant's case file: a reviewer needs to read the history of their own
/// application, and that must not mean handing them the platform audit log.
model PanditReview {
  id              String                 @id @default(cuid())
  panditProfileId String
  reviewerId      String?
  decision        PanditReviewDecision
  fromStatus      PanditOnboardingStatus
  toStatus        PanditOnboardingStatus
  note            String?
  createdAt       DateTime               @default(now())

  pandit   PanditProfile @relation(fields: [panditProfileId], references: [id], onDelete: Cascade)
  reviewer User?         @relation("PanditReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([panditProfileId, createdAt])
}

/// One offered consultation type and its rate.
///
/// Rates are bounded by platform settings on write; the bounds are not stored
/// here, so raising the platform ceiling never silently reprices anyone.
model PanditService {
  id              String        @id @default(cuid())
  panditProfileId String
  mode            ConsultationMode
  enabled         Boolean       @default(false)
  rateType        RateType      @default(PER_MINUTE)
  ratePaise       Int
  sessionMinutes  Int?
  currency        String        @default("INR")
  pandit          PanditProfile @relation(fields: [panditProfileId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([panditProfileId, mode])
}

/// A recurring weekly availability window.
///
/// Minutes from local midnight rather than a display string, so overlap and
/// containment are arithmetic instead of parsing. `weekday` is 0 = Sunday.
model PanditScheduleRule {
  id              String        @id @default(cuid())
  panditProfileId String
  weekday         Int
  startMinute     Int
  endMinute       Int
  pandit          PanditProfile @relation(fields: [panditProfileId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([panditProfileId, weekday])
}

/// A date-specific departure from the weekly rules.
///
/// `available = false` blocks the whole day; `available = true` with a window
/// opens one that the weekly rules do not cover.
model PanditScheduleException {
  id              String        @id @default(cuid())
  panditProfileId String
  date            DateTime      @db.Date
  available       Boolean       @default(false)
  startMinute     Int?
  endMinute       Int?
  note            String?
  pandit          PanditProfile @relation(fields: [panditProfileId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([panditProfileId, date])
}

/* =================================================================== */
/* Consultation chat and scoped Kundli access                          */
/* =================================================================== */

/// A message inside one consultation.
///
/// Scoped to a Consultation rather than to a pair of users, because that is
/// what makes authorization answerable: you may read this thread if you are the
/// customer or the Pandit on that consultation, and there is no shape of
/// request that reaches a thread you are not party to.
model ChatMessage {
  id             String       @id @default(cuid())
  consultationId String
  senderId       String
  body           String
  readAt         DateTime?
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([consultationId, createdAt])
}

/// A customer's explicit, revocable grant of one chart to one Pandit.
///
/// A Pandit never has standing access to charts. Access is created by the
/// customer, for a named consultation, and can be revoked; reading a chart
/// without a live row here is not possible through any Pandit-facing path.
model PanditKundliAccess {
  id              String    @id @default(cuid())
  panditProfileId String
  consultationId  String
  birthProfileId  String
  calculationId   String
  grantedByUserId String
  revokedAt       DateTime?
  expiresAt       DateTime?
  lastViewedAt    DateTime?
  viewCount       Int       @default(0)

  pandit       PanditProfile        @relation(fields: [panditProfileId], references: [id], onDelete: Cascade)
  consultation Consultation         @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  birthProfile BirthProfile         @relation(fields: [birthProfileId], references: [id], onDelete: Cascade)
  calculation  AstrologyCalculation @relation(fields: [calculationId], references: [id], onDelete: Restrict)
  grantedBy    User                 @relation("KundliAccessGrantor", fields: [grantedByUserId], references: [id], onDelete: Cascade)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([consultationId, calculationId])
  @@index([panditProfileId])
}

/* =================================================================== */
/* Earnings and payouts                                                */
/* =================================================================== */

enum EarningStatus {
  PENDING
  ELIGIBLE
  PROCESSING
  PAID
  FAILED
  HELD
  REVERSED
}

enum PayoutStatus {
  PENDING
  ELIGIBLE
  PROCESSING
  PAID
  FAILED
  HELD
}

/// One ledger line per completed, paid consultation.
///
/// `consultationId` is unique, which is what makes duplicate settlement
/// impossible rather than unlikely: a second attempt to settle the same
/// consultation is refused by the database, however the race arrived. Every
/// component is stored in integer paise and the split is snapshotted, so
/// changing the platform commission never rewrites what anyone already earned.
model EarningTransaction {
  id              String        @id @default(cuid())
  panditProfileId String
  consultationId  String?       @unique
  payoutId        String?
  status          EarningStatus @default(PENDING)

  grossAmountPaise        Int
  commissionPercent       Int
  platformCommissionPaise Int
  taxPaise                Int    @default(0)
  adjustmentPaise         Int    @default(0)
  netPayablePaise         Int
  currency                String @default("INR")

  /// When the holding period ends and this becomes payable.
  eligibleAt DateTime?
  settledAt  DateTime?
  heldReason String?
  note       String?

  pandit       PanditProfile @relation(fields: [panditProfileId], references: [id], onDelete: Cascade)
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  payout       Payout?       @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([panditProfileId, status])
  @@index([payoutId])
  @@index([eligibleAt])
}

/// A batch of eligible earnings paid out together.
///
/// No money moves from this application. There is no payout provider wired, so
/// a payout records an operator's off-platform transfer and its reference; the
/// ledger, the states and the idempotency are real, the bank instruction is not
/// simulated.
model Payout {
  id              String       @id @default(cuid())
  payoutNumber    String       @unique
  panditProfileId String
  status          PayoutStatus @default(PENDING)
  amountPaise     Int
  currency        String       @default("INR")
  periodStart     DateTime
  periodEnd       DateTime
  processedById   String?
  processedAt     DateTime?
  /// Operator-entered bank/UTR reference for the transfer they made.
  reference       String?
  failureReason   String?
  heldReason      String?
  note            String?

  pandit      PanditProfile        @relation(fields: [panditProfileId], references: [id], onDelete: Cascade)
  processedBy User?                @relation("PayoutProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  earnings    EarningTransaction[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([panditProfileId, status])
  @@index([status])
}

/// A Pandit's payout destination.
///
/// The account number, IFSC, UPI id and tax id are held only as AES-256-GCM
/// envelopes produced by `lib/settings/crypto.ts`, keyed by an environment-only
/// root key. The plaintext is never returned to any browser, including the
/// Pandit's own: the UI works from the masked columns, and the envelopes exist
/// so a future payout provider can be handed a destination without an operator
/// ever reading one.
model PayoutAccount {
  id              String @id @default(cuid())
  panditProfileId String @unique

  accountHolderName String
  bankName          String?
  /// Display-safe remnants. Everything else about the instrument is ciphertext.
  accountLast4      String?
  ifscMasked        String?
  upiMasked         String?
  taxIdMasked       String?

  accountNumberEnvelope String?
  ifscEnvelope          String?
  upiEnvelope           String?
  taxIdEnvelope         String?

  verifiedAt DateTime?
  pandit     PanditProfile @relation(fields: [panditProfileId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

/* =================================================================== */
/* Support tickets                                                     */
/* =================================================================== */

enum TicketCategory {
  TECHNICAL
  VERIFICATION
  PAYMENT
  PAYOUT
  BOOKING
  PROFILE
  ORDER
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Ticket {
  id            String         @id @default(cuid())
  ticketNumber  String         @unique
  createdById   String
  /// The role the reporter held when they raised it, for triage context.
  createdByRole UserRole
  category      TicketCategory @default(OTHER)
  subject       String
  description   String
  status        TicketStatus   @default(OPEN)
  priority      TicketPriority @default(NORMAL)
  assignedToId  String?
  resolvedAt    DateTime?
  closedAt      DateTime?

  createdBy  User            @relation("TicketReporter", fields: [createdById], references: [id], onDelete: Cascade)
  assignedTo User?           @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   TicketMessage[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([status])
  @@index([createdById])
  @@index([assignedToId])
  @@index([category])
}

model TicketMessage {
  id       String  @id @default(cuid())
  ticketId String
  authorId String
  body     String
  /// An operator note the reporter never sees.
  internal Boolean @default(false)

  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User     @relation("TicketAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}
