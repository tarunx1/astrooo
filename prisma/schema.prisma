generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ASTROLOGER
  EDITOR
  ADMIN
  SUPER_ADMIN
}

enum ProductType {
  PHYSICAL
  DIGITAL_REPORT
  CONSULTATION
  PUJA
  COURSE
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  FULFILLED
  CANCELLED
  REFUNDED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum ReportStatus {
  PENDING_PAYMENT
  PAID
  QUEUED
  CALCULATING
  INTERPRETING
  RENDERING
  READY
  FAILED
  CANCELLED
  REFUNDED
}

enum ConsultationStatus {
  REQUESTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  PREORDER
}

enum BirthTimeAccuracy {
  EXACT
  APPROXIMATE
  UNKNOWN
}

model User {
  id                String             @id @default(cuid())
  name              String             @default("")
  email             String             @unique
  emailVerified     Boolean            @default(false)
  image             String?
  phone             String?            @unique
  role              UserRole           @default(CUSTOMER)
  accounts          Account[]
  sessions          Session[]
  addresses         Address[]
  birthProfiles     BirthProfile[]
  carts             Cart[]
  orders            Order[]
  payments          Payment[]
  reportOrders      ReportOrder[]
  consultations     Consultation[]
  pujaBookings      PujaBooking[]
  enrollments       Enrollment[]
  reviews           Review[]
  wishlistItems     Wishlist[]
  savedKundlis      SavedKundli[]
  auditLogs         AuditLog[]
  inventoryAdjustments InventoryAdjustment[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([role])
}

model Account {
  id                    String    @id @default(cuid())
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String?
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("IN")
  phone      String?
  isDefault  Boolean  @default(false)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model BirthProfile {
  id            String                 @id @default(uuid())
  userId        String?
  name          String
  placeId       String?
  gender        String?
  dateOfBirth   DateTime
  timeOfBirth   String
  timeAccuracy  BirthTimeAccuracy      @default(EXACT)
  placeName     String
  placeOfBirth  String
  city          String
  region        String?
  country       String
  latitude      Decimal                @db.Decimal(9, 6)
  longitude     Decimal                @db.Decimal(9, 6)
  timezone      String
  user          User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  calculations  AstrologyCalculation[]
  savedKundlis  SavedKundli[]
  reportOrders  ReportOrder[]
  consultations Consultation[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([userId])
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  articles  Article[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([parentId])
}

model Product {
  id               String           @id @default(cuid())
  type             ProductType
  title            String
  slug             String           @unique
  description      String
  categoryId       String?
  pricePaise       Int
  salePricePaise   Int?
  currency         String           @default("INR")
  sku              String?          @unique
  attributes       Json?
  active           Boolean          @default(false)
  category         Category?        @relation(fields: [categoryId], references: [id])
  variants         ProductVariant[]
  images           ProductImage[]
  inventory        Inventory?
  cartItems        CartItem[]
  orderItems       OrderItem[]
  reportDefinition ReportDefinition?
  reviews          Review[]
  wishlistItems    Wishlist[]
  couponProducts   CouponProduct[]
  inventoryAdjustments InventoryAdjustment[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([type])
  @@index([categoryId])
  @@index([active])
}

model ProductVariant {
  id             String       @id @default(cuid())
  productId      String
  title          String
  sku            String       @unique
  pricePaise     Int?
  salePricePaise Int?
  attributes     Json?
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory      Inventory?
  cartItems      CartItem[]
  orderItems     OrderItem[]
  inventoryAdjustments InventoryAdjustment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([productId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

model Inventory {
  id                String           @id @default(cuid())
  productId         String?          @unique
  productVariantId  String?          @unique
  quantity          Int              @default(0)
  status            InventoryStatus  @default(OUT_OF_STOCK)
  product           Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant    ProductVariant?  @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  updatedAt         DateTime         @updatedAt
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  /// SHA-256 of the opaque anonymous cart cookie. The raw token is never stored.
  sessionId String?
  status    CartStatus @default(ACTIVE)
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
  @@index([sessionId])
  @@index([status])
}

model CartItem {
  id               String          @id @default(cuid())
  cartId           String
  productId        String
  productVariantId String?
  quantity         Int             @default(1)
  cart             Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id])
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([cartId, productId, productVariantId])
  @@index([productId])
}

model Order {
  id              String       @id @default(cuid())
  /// Human-facing reference shown to the customer and support.
  orderNumber     String       @unique
  userId          String
  cartId          String?
  status          OrderStatus  @default(PENDING_PAYMENT)
  subtotalPaise   Int
  discountPaise   Int          @default(0)
  taxPaise        Int          @default(0)
  shippingPaise   Int          @default(0)
  totalPaise      Int
  currency        String       @default("INR")
  shippingAddress Json?
  billingAddress  Json?
  user            User         @relation(fields: [userId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  refunds         Refund[]
  reportOrders    ReportOrder[]
  pujaBookings    PujaBooking[]
  enrollments     Enrollment[]
  couponId        String?
  /// Snapshot so a renamed or deleted coupon never rewrites order history.
  couponCodeSnapshot String?
  coupon          Coupon?      @relation(fields: [couponId], references: [id], onDelete: SetNull)

  /// Razorpay order id. Unique so one provider order maps to one internal order.
  providerOrderId String?      @unique
  paidAt          DateTime?

  /// Fulfilment metadata, entered manually by an operator. No carrier
  /// integration exists, so none of this is verified against a carrier.
  carrierName    String?
  trackingNumber String?
  trackingUrl    String?
  processingAt   DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?

  /// Set exactly once when stock is decremented, making commitment idempotent
  /// against duplicate payment events.
  inventoryCommittedAt DateTime?
  /// Records any line that could not be fulfilled from stock after payment.
  inventoryShortfall   Json?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId])
  @@index([status])
  @@index([providerOrderId])
}

/// A purchased line. Every displayed value is a snapshot taken at purchase time,
/// so later edits to a product's title, SKU or price never rewrite history.
model OrderItem {
  id               String          @id @default(cuid())
  orderId          String
  productId        String
  productVariantId String?
  title            String
  skuSnapshot      String?
  variantSnapshot  Json?
  quantity         Int             @default(1)
  unitPricePaise   Int
  totalPaise       Int
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String?
  orderId           String?
  reportOrderId     String?
  provider          String
  providerOrderId   String?
  providerPaymentId String?       @unique
  providerRef       String?       @unique
  status            PaymentStatus @default(PENDING)
  amountPaise       Int
  currency          String        @default("INR")
  rawResponse       Json?
  capturedAt        DateTime?
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  order             Order?        @relation(fields: [orderId], references: [id])
  reportOrder       ReportOrder?  @relation(fields: [reportOrderId], references: [id])
  refunds           Refund[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@index([orderId])
  @@index([reportOrderId])
  @@index([providerOrderId])
  @@index([status])
}

model Refund {
  id          String        @id @default(cuid())
  orderId     String
  paymentId   String
  amountPaise Int
  reason      String?
  status      PaymentStatus @default(PENDING)
  order       Order         @relation(fields: [orderId], references: [id])
  payment     Payment       @relation(fields: [paymentId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orderId])
  @@index([paymentId])
}

model ReportDefinition {
  id               String        @id @default(cuid())
  productId        String?       @unique
  slug             String        @unique
  name             String
  shortDescription String
  description      String
  priceMinor       Int
  currency         String        @default("INR")
  estimatedPages   Int
  sectionsIncluded Json
  requiredInputs   Json
  isActive         Boolean       @default(true)
  sortOrder        Int           @default(0)
  reportType       String
  requiredFields   Json
  sections         Json
  samplePages      Json?
  product          Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  reportOrders     ReportOrder[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([isActive, sortOrder])
  @@index([slug])
}

model ReportOrder {
  id                     String               @id @default(cuid())
  userId                 String
  orderId                String?
  reportDefinitionId     String
  birthProfileId         String?
  astrologyCalculationId String?
  status                 ReportStatus         @default(PENDING_PAYMENT)
  priceMinor             Int
  currency               String               @default("INR")
  reportNameSnapshot     String
  reportSlugSnapshot     String
  priceSnapshot          Int
  currencySnapshot       String
  providerOrderId        String?              @unique
  inputSnapshot          Json
  paidAt                 DateTime?
  user                   User                 @relation(fields: [userId], references: [id])
  order                  Order?               @relation(fields: [orderId], references: [id])
  reportDefinition       ReportDefinition     @relation(fields: [reportDefinitionId], references: [id])
  birthProfile           BirthProfile?        @relation(fields: [birthProfileId], references: [id], onDelete: SetNull)
  astrologyCalculation   AstrologyCalculation? @relation(fields: [astrologyCalculationId], references: [id], onDelete: Restrict)
  payments               Payment[]
  generatedReport        GeneratedReport?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([userId])
  @@index([status])
  @@index([reportDefinitionId])
  @@index([birthProfileId])
  @@index([astrologyCalculationId])
}

model GeneratedReport {
  id            String      @id @default(cuid())
  reportOrderId String      @unique
  status        ReportStatus @default(QUEUED)

  /// Validated ReportDocument. Never a raw unvalidated prose blob.
  document      Json?
  interpretation Json?
  chartJson     Json?

  /// Reproducibility / audit: what produced this document.
  schemaVersion          String?
  promptVersion          String?
  aiProvider             String?
  aiModel                String?
  astrologyCalculationId String?
  generatedAt            DateTime?

  /// Bounded retry bookkeeping.
  attemptCount      Int       @default(0)
  lastErrorCategory String?
  lastError         String?
  lastErrorAt       DateTime?

  /// Rendered artefact (Phase 3). Null until RENDERING completes.
  storageKey String?
  checksum   String?
  fileSize   Int?
  mimeType   String?
  pageCount  Int?
  readyAt    DateTime?

  reportOrder ReportOrder @relation(fields: [reportOrderId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@index([astrologyCalculationId])
}

model Astrologer {
  id            String             @id @default(cuid())
  name          String
  slug          String             @unique
  bio           String?
  specialties   String[]
  languages     String[]
  active        Boolean            @default(false)
  slots         ConsultationSlot[]
  consultations Consultation[]
  reviews       Review[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model ConsultationSlot {
  id           String         @id @default(cuid())
  astrologerId String
  startsAt     DateTime
  endsAt       DateTime
  isBooked     Boolean        @default(false)
  astrologer   Astrologer     @relation(fields: [astrologerId], references: [id], onDelete: Cascade)
  consultation Consultation?

  @@index([astrologerId, startsAt])
}

model Consultation {
  id             String             @id @default(cuid())
  userId         String
  astrologerId   String
  slotId         String?            @unique
  birthProfileId String?
  status         ConsultationStatus @default(REQUESTED)
  mode           String
  notes          String?
  user           User               @relation(fields: [userId], references: [id])
  astrologer     Astrologer         @relation(fields: [astrologerId], references: [id])
  slot           ConsultationSlot?  @relation(fields: [slotId], references: [id])
  birthProfile   BirthProfile?      @relation(fields: [birthProfileId], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([userId])
  @@index([astrologerId])
  @@index([status])
}

model Puja {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String
  pricePaise  Int
  active      Boolean       @default(false)
  bookings    PujaBooking[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model PujaBooking {
  id        String   @id @default(cuid())
  userId    String
  orderId   String?
  pujaId    String
  date      DateTime?
  status    String   @default("REQUESTED")
  user      User     @relation(fields: [userId], references: [id])
  order     Order?   @relation(fields: [orderId], references: [id])
  puja      Puja     @relation(fields: [pujaId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([pujaId])
}

model Course {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String
  pricePaise  Int
  active      Boolean      @default(false)
  enrollments Enrollment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  orderId   String?
  user      User     @relation(fields: [userId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])
  order     Order?   @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([orderId])
}

model ArticleCategory {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  articles  Article[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Article {
  id                String           @id @default(cuid())
  title             String
  slug              String           @unique
  excerpt           String?
  content           String
  publishedAt       DateTime?
  categoryId        String?
  articleCategoryId String?
  category          Category?        @relation(fields: [categoryId], references: [id])
  articleCategory   ArticleCategory? @relation(fields: [articleCategoryId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([publishedAt])
  @@index([categoryId])
  @@index([articleCategoryId])
}

model Review {
  id           String      @id @default(cuid())
  userId       String
  productId    String?
  astrologerId String?
  rating       Int
  title        String?
  body         String?
  published    Boolean     @default(false)
  user         User        @relation(fields: [userId], references: [id])
  product      Product?    @relation(fields: [productId], references: [id])
  astrologer   Astrologer? @relation(fields: [astrologerId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([productId])
  @@index([astrologerId])
  @@index([published])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

model Coupon {
  id               String          @id @default(cuid())
  code             String          @unique
  description      String?
  percentOff       Int?
  amountOffPaise   Int?
  minOrderPaise    Int?
  maxDiscountPaise Int?
  usageLimit       Int?
  perUserLimit     Int?
  timesRedeemed    Int             @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  active           Boolean         @default(false)
  orders           Order[]
  products         CouponProduct[]
  redemptions      CouponRedemption[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([active])
}

/// One row per user per redeemed order, so perUserLimit is enforced against
/// facts rather than a counter that can drift.
model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([couponId, orderId])
  @@index([couponId, userId])
}

model CouponProduct {
  couponId  String
  productId String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
}

model AstrologyCalculation {
  id             String        @id @default(uuid())
  birthProfileId String?
  calculationType String
  provider       String
  providerVersion String
  calculationVersion String
  ayanamsa       String?
  houseSystem    String?
  calculatedAt   DateTime?
  inputHash      String
  input          Json
  result         Json?
  status         String        @default("PENDING")
  birthProfile   BirthProfile? @relation(fields: [birthProfileId], references: [id], onDelete: SetNull)
  savedKundlis   SavedKundli[]
  reportOrders   ReportOrder[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([birthProfileId])
  @@index([calculationType])
  @@index([inputHash])
  @@index([status])
  @@unique([calculationType, inputHash, provider, calculationVersion])
}

model PaymentWebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String    @unique
  eventType       String
  payload         Json?
  createdAt       DateTime  @default(now())
  processedAt     DateTime?

  @@index([provider])
  @@index([eventType])
  @@index([processedAt])
}

/// A user's explicit save of a Kundli result.
///
/// AstrologyCalculation rows are globally deduplicated by inputHash, so a single
/// calculation can be reached by several people who entered identical birth
/// details. Ownership therefore lives here rather than on the calculation: each
/// saving user gets their own BirthProfile copy and their own SavedKundli row,
/// and no user's save can ever mutate or re-point another user's profile.
model SavedKundli {
  id             String               @id @default(cuid())
  userId         String
  birthProfileId String
  calculationId  String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthProfile   BirthProfile         @relation(fields: [birthProfileId], references: [id], onDelete: Cascade)
  calculation    AstrologyCalculation @relation(fields: [calculationId], references: [id], onDelete: Restrict)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([userId, calculationId])
  @@index([userId])
  @@index([birthProfileId])
  @@index([calculationId])
}

enum InventoryAdjustmentReason {
  RESTOCK
  CORRECTION
  DAMAGED
  RETURN
  MANUAL
}

/// Every deliberate stock change, with who made it and why.
///
/// Stock is never mutated without a row here: the adjustment and the write to
/// Inventory happen in one transaction, so the running total is always
/// explainable from history.
model InventoryAdjustment {
  id               String                    @id @default(cuid())
  productId        String?
  productVariantId String?
  adminUserId      String
  delta            Int
  previousQuantity Int
  newQuantity      Int
  reason           InventoryAdjustmentReason @default(MANUAL)
  note             String?
  createdAt        DateTime                  @default(now())

  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  adminUser      User            @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([productVariantId])
  @@index([createdAt])
}

enum AuditAction {
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_PRICE_CHANGED
  PRODUCT_ACTIVATED
  PRODUCT_DEACTIVATED
  PRODUCT_VARIANT_CREATED
  PRODUCT_VARIANT_UPDATED
  INVENTORY_ADJUSTED
  ORDER_STATUS_CHANGED
  ORDER_SHIPMENT_UPDATED
  REPORT_DEFINITION_UPDATED
  REPORT_DEFINITION_ACTIVATED
  REPORT_DEFINITION_DEACTIVATED
  REPORT_GENERATION_RETRIED
  COUPON_CREATED
  COUPON_UPDATED
  COUPON_ACTIVATED
  COUPON_DEACTIVATED
  USER_ROLE_CHANGED
}

/// Append-only record of sensitive operator actions.
///
/// There is deliberately no update or delete path in the admin UI. `metadata`
/// carries only safe descriptive values: never a secret, token, prompt or raw
/// provider payload.
model AuditLog {
  id          String      @id @default(cuid())
  actorUserId String
  action      AuditAction
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime    @default(now())

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}
